# Copy this file to .env and fill in the values.
# .env is ignored by git — keep secrets out of the repo.

# Groq API key (same as the Worker's GROQ_API_KEY secret)
GROQ_API_KEY=

# Telegram bot token (same as the Worker's BOT_TOKEN secret) — used to notify you after upload
BOT_TOKEN=
# Your personal Telegram chat id (find it via the bot's /stats or @userinfobot)
TELEGRAM_CHAT_ID=

# Cloudflare credentials to read/write the bot's KV namespace from this machine
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
KV_NAMESPACE_ID=59ff4573092e4901b72f53d96d999aef

# Google OAuth (Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Desktop app")
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Optional tweaks
# GROQ_MODEL=llama-3.1-8b-instant
# VOICE=en-US-ChristopherNeural
# MUSIC=/path/to/background-music.mp3
# PRIVACY=private
# OUT_DIR=./out
# POLL_SECONDS=60
# REDIRECT_PORT=8770
